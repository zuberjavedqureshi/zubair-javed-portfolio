# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Contact form endpoint from Formspree (free tier): https://formspree.io
# Create a form, then copy its endpoint, which looks like https://formspree.io/f/abcdwxyz
# This value is public by design (it is what the browser posts to); it is not a secret.
# While unset, the contact form shows a notice and submission is disabled.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Optional: canonical site URL, if it differs from https://zubair-javed-portfolio.vercel.app
# NEXT_PUBLIC_SITE_URL=
